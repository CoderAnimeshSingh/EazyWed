# ========================
# SERVER CONFIGURATION
# ========================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ========================
# DATABASE CONFIGURATION
# ========================
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/eazywed?retryWrites=true&w=majority

# ========================
# JWT AUTHENTICATION
# ========================
# Generate a strong secret key (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_make_it_long_and_unique_minimum_32_characters

# ========================
# CLOUDINARY SETUP (Image Hosting)
# ========================
# Sign up at: https://cloudinary.com
# Dashboard → Settings → Copy credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# TWILIO SETUP (SMS & OTP)
# ========================
# Sign up at: https://www.twilio.com
# Account → Account SID, Auth Token, Phone Number
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890

# ========================
# EMAIL CONFIGURATION (Optional)
# ========================
# For Gmail: Use App Password (not regular password)
# Enable 2FA first, then create app password
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# ========================
# INSTRUCTIONS
# ========================
# 1. Copy this file and name it .env
# 2. Replace all placeholder values with your actual credentials
# 3. Keep .env file private (add to .gitignore)
# 4. Never commit .env file to GitHub
# 5. For production, use strong, unique credentials
